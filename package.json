{
  "name": "skybox-studio-runtime",
  "version": "0.1.1",
  "description": "Three.js runtime for live and baked Skybox Studio manifests.",
  "type": "module",
  "license": "MIT",
  "author": "Ivan Juarez <ivan@blindgazer.com>",
  "homepage": "https://github.com/vanrez-nez/skybox-studio-runtime#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanrez-nez/skybox-studio-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/vanrez-nez/skybox-studio-runtime/issues"
  },
  "keywords": [
    "three",
    "threejs",
    "skybox",
    "equirectangular",
    "webgpu",
    "tsl",
    "starfield",
    "procedural",
    "gradient",
    "hdr"
  ],
  "sideEffects": [
    "**/layer-addons/builtins/*.ts",
    "**/layer-addons/builtins/*.js",
    "**/starfield.ts",
    "**/starfield.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./starfield": {
      "types": "./dist/starfield.d.ts",
      "import": "./dist/starfield.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "pack:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run test && npm run build && npm run pack:dry-run",
    "test": "vitest run"
  },
  "peerDependencies": {
    "three": "^0.184.0"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.7"
  }
}
